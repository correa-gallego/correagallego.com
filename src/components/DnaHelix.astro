---
// A DNA double helix drawn as two out-of-phase sine strands with base-pair
// rungs. Geometry is computed at build time; motion is CSS scroll-driven.
const cx = 50;
const amp = 30;
const period = 150;   // vertical units per full turn
const turns = 20;
const step = 6;
const height = period * turns;

const strand = (phase0: number) => {
  let pts = '';
  for (let y = 0; y <= height; y += step) {
    const x = cx + amp * Math.sin((y / period) * Math.PI * 2 + phase0);
    pts += `${x.toFixed(1)},${y.toFixed(1)} `;
  }
  return pts.trim();
};

const strandA = strand(0);
const strandB = strand(Math.PI);

const rungs: { x1: string; x2: string; y: string; op: string }[] = [];
for (let y = 0; y <= height; y += period / 9) {
  const ph = (y / period) * Math.PI * 2;
  const x1 = cx + amp * Math.sin(ph);
  const x2 = cx + amp * Math.sin(ph + Math.PI);
  const sep = Math.abs(x1 - x2) / (2 * amp); // 0 at crossings, 1 facing viewer
  rungs.push({
    x1: x1.toFixed(1),
    x2: x2.toFixed(1),
    y: y.toFixed(1),
    op: (0.1 + sep * 0.55).toFixed(2),
  });
}
---

<svg
  class="dna__svg"
  viewBox={`0 0 100 ${height}`}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMin meet"
>
  <polyline points={strandA} stroke="currentColor" stroke-width="2.2" opacity="0.9" stroke-linecap="round" />
  <polyline points={strandB} stroke="currentColor" stroke-width="2.2" opacity="0.5" stroke-linecap="round" />
  {rungs.map((r) => (
    <line x1={r.x1} y1={r.y} x2={r.x2} y2={r.y} stroke="currentColor" stroke-width="1.5" opacity={r.op} stroke-linecap="round" />
  ))}
</svg>
