---
// Right-margin instrument: the "community response" — a vertical scatter of
// morphotypes/colonies whose size and spread reorganize along the gradient
// axis (sparse and small near the light, richest through the penumbra).
// Deterministic geometry computed at build time.
const H = 1200;
const W = 60;
const N = 46;

let seed = 20260703;
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};

type Dot = { x: string; y: string; r: string; op: string };
const dots: Dot[] = [];
for (let i = 0; i < N; i++) {
  const y = ((i + rnd() * 0.7) / N) * H;
  const t = y / H;                      // 0 = light zone, 1 = aphotic
  const peak = 1 - Math.abs(t - 0.46) * 2; // biomass peaks in the penumbra
  const x = W / 2 + (rnd() - 0.5) * (8 + t * 26);
  const r = 1.1 + rnd() * (1.1 + Math.max(0, peak) * 2.4);
  const op = 0.22 + Math.max(0, peak) * 0.4 + rnd() * 0.15;
  dots.push({ x: x.toFixed(1), y: y.toFixed(1), r: r.toFixed(2), op: op.toFixed(2) });
}
---
<aside class="field" aria-hidden="true">
  <svg class="field__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" fill="none">
    {dots.map((d) => (
      <circle cx={d.x} cy={d.y} r={d.r} fill="currentColor" opacity={d.op} />
    ))}
  </svg>
</aside>
