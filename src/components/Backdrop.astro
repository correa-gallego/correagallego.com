---
// Generative "field-notebook" backdrop.
//   · right  = a tree of life after Darwin's 1837 "I think" sketch — mostly
//              straight, asymmetric (a main axis throwing lateral branches),
//              terminal ticks, a circled base node. Draws itself on scroll.
//   · around = hand-drawn microbial specimens (faint colour washes) + contours.
// All geometry is deterministic (seeded) and computed at build time.

let s = 73_313;
const rnd = () => {
  s = (s * 1103515245 + 12345) & 0x7fffffff;
  return s / 0x7fffffff;
};
const rr = (a: number, b: number) => a + rnd() * (b - a);
const f = (n: number) => n.toFixed(1);

const VW = 1440;
const VH = 920;

/* ---------- Tree of life (Darwin-style, self-drawing, three tiers) ---------- */
const tree: string[][] = [[], [], []];
const maxGen = 5;
const seg = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = x2 - x1, dy = y2 - y1;
  const len = Math.hypot(dx, dy) || 1;
  const off = rr(-0.045, 0.045) * len; // near-straight, faint hand tremor
  const cx = (x1 + x2) / 2 - (dy / len) * off;
  const cy = (y1 + y2) / 2 + (dx / len) * off;
  return `M${f(x1)} ${f(y1)} Q ${f(cx)} ${f(cy)} ${f(x2)} ${f(y2)}`;
};
const tip = (x: number, y: number, ang: number) => {
  if (rnd() < 0.62) {
    const px = Math.cos(ang + Math.PI / 2), py = -Math.sin(ang + Math.PI / 2);
    return `M${f(x - px * 5.5)} ${f(y - py * 5.5)} L ${f(x + px * 5.5)} ${f(y + py * 5.5)}`;
  }
  return `M${f(x - 2.6)} ${f(y)} a 2.6 2.6 0 1 0 5.2 0 a 2.6 2.6 0 1 0 -5.2 0`;
};
const grow = (x: number, y: number, ang: number, len: number, gen: number) => {
  const x2 = x + Math.cos(ang) * len;
  const y2 = y - Math.sin(ang) * len;
  const tier = gen <= 1 ? 0 : gen === 2 ? 1 : 2;
  tree[tier].push(seg(x, y, x2, y2));
  if (gen >= maxGen || len < 18) { tree[2].push(tip(x2, y2, ang)); return; }
  if (rnd() < 0.55 && gen >= 1) {
    // main axis continues + one lateral branch (the Darwin signature)
    grow(x2, y2, ang + rr(-0.12, 0.12), len * rr(0.74, 0.86), gen + 1);
    grow(x2, y2, ang + (rnd() < 0.5 ? 1 : -1) * rr(0.42, 0.72), len * rr(0.46, 0.66), gen + 1);
  } else {
    const sp = rr(0.34, 0.58);
    grow(x2, y2, ang - sp, len * rr(0.64, 0.8), gen + 1);
    grow(x2, y2, ang + sp, len * rr(0.64, 0.8), gen + 1);
  }
};
tree[0].push(`M${f(1165 - 6)} 905 a 6 6 0 1 0 12 0 a 6 6 0 1 0 -12 0`); // circled base node
grow(1165, 899, Math.PI / 2 + 0.12, 150, 0);

/* ---------- Microbial specimens (faint colour washes) ---------- */
const glyphs: (() => string)[] = [
  () => `<circle cx="-6" cy="-5" r="5.2"/><circle cx="5" cy="-3" r="6.6"/><circle cx="-3" cy="6" r="4.6"/><circle cx="9" cy="8" r="3.6"/><path d="M-0.5 -8.4 A6.6 6.6 0 0 1 -0.5 2.4"/><path d="M-9.5 -6.8 A5.2 5.2 0 0 0 -1.6 -3.4"/>`,
  () => `<rect x="-17" y="-5" width="23" height="9.2" rx="4.6"/><line x1="-5.5" y1="-5" x2="-5.5" y2="4.2"/><rect x="-3" y="7" width="17" height="7.6" rx="3.8"/><rect x="3" y="-14" width="14" height="6.6" rx="3.3"/>`,
  () => `<path d="M-22 3 q6 -11 12 -3 t12 -3 t12 -3"/><line x1="-16.5" y1="-1.2" x2="-14.5" y2="2.6"/><line x1="-4.5" y1="-3.6" x2="-2.5" y2="0.2"/><line x1="7" y1="-5.6" x2="9" y2="-1.8"/><circle cx="16" cy="-6" r="2.4"/>`,
  () => `<path d="M-19 0 Q0 -8 19 0 Q0 8 -19 0 Z"/><line x1="-15" y1="0" x2="15" y2="0"/><line x1="-11" y1="-4.4" x2="-11" y2="4.4"/><line x1="-5.5" y1="-5.6" x2="-5.5" y2="5.6"/><line x1="0" y1="-6" x2="0" y2="6"/><line x1="5.5" y1="-5.6" x2="5.5" y2="5.6"/><line x1="11" y1="-4.4" x2="11" y2="4.4"/>`,
  () => `<path d="M0 17 L0 5 M0 5 L-9 -6 M0 5 L9 -6 M-9 -6 L-13 -15 M-9 -6 L-4 -14 M9 -6 L4 -14 M9 -6 L14 -15"/><circle cx="-13" cy="-15" r="1.6"/><circle cx="-4" cy="-14" r="1.6"/><circle cx="4" cy="-14" r="1.6"/><circle cx="14" cy="-15" r="1.6"/>`,
  () => `<path d="M-16 6 C -10 -10, -2 -10, 2 0 S 12 10, 16 -6"/><path d="M16 -6 q5 -2 7 -6 t7 -4"/>`,
  () => `<circle cx="-6" cy="1" r="10"/><circle cx="9" cy="-6" r="5.6"/><circle cx="18" cy="-11" r="3.2"/><path d="M2.5 -3 a2 2 0 0 1 3 0"/>`,
  () => `<circle cx="0" cy="0" r="11"/><circle cx="0" cy="0" r="5.4"/><line x1="0" y1="-16" x2="0" y2="16"/><line x1="-16" y1="0" x2="16" y2="0"/><line x1="-11" y1="-11" x2="11" y2="11"/><line x1="-11" y1="11" x2="11" y2="-11"/>`,
  // colony / plate with stipple
  () => `<ellipse cx="0" cy="0" rx="16" ry="12"/><ellipse cx="1" cy="0" rx="10" ry="7.6"/><circle cx="-5" cy="-2" r="1.1"/><circle cx="3" cy="3" r="1.1"/><circle cx="6" cy="-4" r="1.1"/><circle cx="-7" cy="5" r="1.1"/>`,
  // hyphal network
  () => `<path d="M-18 11 Q-8 6 -2 -2 M-2 -2 L6 -8 M-2 -2 L3 -11 M6 -8 L13 -10 M6 -8 L9 -16 M-9 3 L-14 -4"/>`,
];
const tints = ['tint-slate', 'tint-teal', 'tint-sage', 'tint-blue', 'tint-ochre', 'tint-slate', 'tint-teal'];

type Spec = { g: string; x: number; y: number; sc: number; rot: number; t: string };
const layers: Spec[][] = [[], [], []];
const N = 16;
for (let i = 0; i < N; i++) {
  const left = rnd() < 0.62;
  const x = left ? rr(28, 335) : rr(1120, 1414);
  const y = rr(48, 872);
  layers[i % 3].push({
    g: glyphs[Math.floor(rnd() * glyphs.length)](),
    x, y,
    sc: rr(0.72, 1.7),
    rot: rr(-26, 26),
    t: tints[Math.floor(rnd() * tints.length)],
  });
}

/* ---------- Contour foci ---------- */
const contour = (cx: number, cy: number, rings: number) => {
  let out = '';
  for (let k = 1; k <= rings; k++) {
    const rx = 15 * k * rr(0.85, 1.12);
    const ry = rx * rr(0.55, 0.72);
    out += `<ellipse cx="${cx}" cy="${cy}" rx="${f(rx)}" ry="${f(ry)}" transform="rotate(${f(rr(-22, 22))} ${cx} ${cy})"/>`;
  }
  return out;
};
const contours = contour(165, 235, 5) + contour(300, 760, 5);

const specGroup = (list: Spec[]) =>
  list.map((d) => `<g class="${d.t}" transform="translate(${f(d.x)} ${f(d.y)}) rotate(${f(d.rot)}) scale(${d.sc.toFixed(2)})">${d.g}</g>`).join('');
const treeGroup = (list: string[]) => list.map((d) => `<path d="${d}" pathLength="1"/>`).join('');
---

<div class="bd" aria-hidden="true">
  <svg class="bd__svg" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
    <g class="bd__contours" set:html={contours} />
    <g class="bd__tree bd__tree0" set:html={treeGroup(tree[0])} />
    <g class="bd__tree bd__tree1" set:html={treeGroup(tree[1])} />
    <g class="bd__tree bd__tree2" set:html={treeGroup(tree[2])} />
    <g class="bd__l1" set:html={specGroup(layers[0])} />
    <g class="bd__l2" set:html={specGroup(layers[1])} />
    <g class="bd__l3" set:html={specGroup(layers[2])} />
  </svg>
</div>
