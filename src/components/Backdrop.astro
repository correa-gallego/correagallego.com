---
// Generative "field-notebook" backdrop: faint hand-drawn microbial specimens
// and contour lines, scattered mostly to the periphery. Layers drift and
// progressively emerge on scroll — a community assembling along the gradient.
// Geometry is deterministic (seeded) and computed at build time.

let s = 73_313;
const rnd = () => {
  s = (s * 1103515245 + 12345) & 0x7fffffff;
  return s / 0x7fffffff;
};
const rr = (a: number, b: number) => a + rnd() * (b - a);

// --- Specimen glyphs (drawn in a local ~±20 box, uniform line weight) ---
const glyphs: (() => string)[] = [
  // coccus cluster
  () => `<circle cx="-6" cy="-5" r="5"/><circle cx="5" cy="-3" r="6.5"/><circle cx="-3" cy="6" r="4.5"/><circle cx="9" cy="8" r="3.6"/><circle cx="-11" cy="4" r="3"/>`,
  // bacilli
  () => `<rect x="-16" y="-5" width="22" height="9" rx="4.5"/><rect x="-3" y="7" width="17" height="7.5" rx="3.7"/><rect x="2" y="-13" width="14" height="6.5" rx="3.2"/>`,
  // filament
  () => `<path d="M-20 2 q6 -10 12 -2 t12 -2 t12 -2"/><circle cx="-20" cy="2" r="1.6"/><circle cx="16" cy="-4" r="1.6"/>`,
  // diatom (pennate)
  () => `<ellipse cx="0" cy="0" rx="18" ry="6.5"/><line x1="-11" y1="-4.4" x2="-11" y2="4.4"/><line x1="-5.5" y1="-5.6" x2="-5.5" y2="5.6"/><line x1="0" y1="-6" x2="0" y2="6"/><line x1="5.5" y1="-5.6" x2="5.5" y2="5.6"/><line x1="11" y1="-4.4" x2="11" y2="4.4"/>`,
  // branching lineage (contingency / convergence)
  () => `<path d="M0 17 L0 5 M0 5 L-9 -6 M0 5 L9 -6 M-9 -6 L-13 -15 M-9 -6 L-4 -14 M9 -6 L4 -14 M9 -6 L14 -15"/><circle cx="-13" cy="-15" r="1.5"/><circle cx="-4" cy="-14" r="1.5"/><circle cx="4" cy="-14" r="1.5"/><circle cx="14" cy="-15" r="1.5"/>`,
  // spirillum
  () => `<path d="M-16 6 C -10 -10, -2 -10, 2 0 S 12 10, 16 -6"/>`,
  // budding cell (yeast — nod to the Purdue work)
  () => `<circle cx="-3" cy="0" r="10"/><circle cx="11" cy="-6" r="5"/>`,
];

type Spec = { g: string; x: number; y: number; sc: number; rot: number };
const layers: Spec[][] = [[], [], []];
const N = 22;
for (let i = 0; i < N; i++) {
  const side = rnd() < 0.5 ? 0 : 1;
  const x = side === 0 ? rr(28, 355) : rr(1085, 1412);
  const y = rr(70, 1930);
  layers[i % 3].push({
    g: glyphs[Math.floor(rnd() * glyphs.length)](),
    x,
    y,
    sc: rr(0.7, 1.85),
    rot: rr(-28, 28),
  });
}

// --- Contour foci (topographic / fitness-landscape texture) ---
const contour = (cx: number, cy: number, rings: number) => {
  let out = '';
  for (let k = 1; k <= rings; k++) {
    const rx = 15 * k * rr(0.85, 1.12);
    const ry = rx * rr(0.55, 0.72);
    out += `<ellipse cx="${cx}" cy="${cy}" rx="${rx.toFixed(1)}" ry="${ry.toFixed(1)}" transform="rotate(${rr(-22, 22).toFixed(1)} ${cx} ${cy})"/>`;
  }
  return out;
};
const contours = contour(190, 340, 6) + contour(1230, 780, 7) + contour(150, 1500, 6) + contour(1280, 1720, 5);

const specGroup = (list: Spec[]) =>
  list
    .map((d) => `<g transform="translate(${d.x.toFixed(1)} ${d.y.toFixed(1)}) rotate(${d.rot.toFixed(1)}) scale(${d.sc.toFixed(2)})">${d.g}</g>`)
    .join('');
---

<div class="bd" aria-hidden="true">
  <svg class="bd__svg" viewBox="0 0 1440 2000" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1.3">
    <g class="bd__contours" set:html={contours} />
    <g class="bd__l1" set:html={specGroup(layers[0])} />
    <g class="bd__l2" set:html={specGroup(layers[1])} />
    <g class="bd__l3" set:html={specGroup(layers[2])} />
  </svg>
</div>
