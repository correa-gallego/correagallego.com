---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'profile' | 'article';
}

const {
  title,
  description = 'Sebastian Correa-Gallego — biologist (B.Sc., Universidad EAFIT). Microbial community assembly, and whether the state a community reaches can be predicted from how its cells allocate finite resources.',
  ogType = 'profile',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/assets/field.webp', Astro.site).toString();
const ogImageAlt =
  'Sebastian Correa-Gallego taking samples by headlamp in the Organal San Antonio, a volcaniclastic cave in Támesis, Colombia.';
const cv = '/assets/Sebastian-Correa-Gallego-CV.pdf';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sebastian Correa-Gallego',
  givenName: 'Sebastian',
  familyName: 'Correa-Gallego',
  url: 'https://correagallego.com',
  email: 'mailto:correagsebastian2204@gmail.com',
  jobTitle: 'Biologist',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad EAFIT', address: 'Medellín, Colombia' },
  knowsAbout: [
    'Microbial Ecology',
    'Community Assembly',
    'Evolutionary Biology',
    'Cellular Resource Allocation',
    'Microbiology',
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: 'https://orcid.org/0009-0007-8703-3188',
  },
  sameAs: [
    'https://orcid.org/0009-0007-8703-3188',
    'https://scholar.google.com/citations?user=fy4svCIAAAAJ',
    'https://github.com/correa-gallego',
    'https://bsky.app/profile/prometheoarchaeum.bsky.social',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Sebastian Correa-Gallego">
  <meta name="theme-color" content="#eef0f2">
  <link rel="canonical" href={canonicalURL}>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">
  <link rel="sitemap" href="/sitemap-index.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Roboto+Serif:ital,opsz,wght@1,8..144,400;1,8..144,500&display=swap">

  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content="Sebastian Correa-Gallego">
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:locale" content="en_US">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <a class="cv-link" href={cv} rel="noopener" target="_blank">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
      <path d="M14 3v5h5"></path>
      <path d="M9 13h6M9 17h4"></path>
    </svg>
    <span class="cv-link__full">Curriculum Vitae</span>
    <span class="cv-link__short">CV</span>
  </a>
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
