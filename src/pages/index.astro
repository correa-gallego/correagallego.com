            <circle class="fig__node" cx="212" cy="99" r="5" />
            <circle class="fig__node" cx="292" cy="99" r="5" />
            <text class="fig__label" x="252" y="126" text-anchor="middle">contingent</text>
            <text class="fig__sublabel" x="252" y="141" text-anchor="middle">two basins</text>

            <path class="fig__axis" d="M18,162 H 322 M88,162 V 166 M252,162 V 166 M317,158 L322,162 L317,166" />
            <text class="fig__sublabel" x="170" y="182" text-anchor="middle">spread of allocation strategies in the pool</text>
          </svg>

          <figcaption class="fig__caption">
            A schematic of the conjecture: how widely a pool spans the rate–yield axis should set
            whether assembly has a single stable outcome or more than one.
          </figcaption>
        </figure>
      </div>

    </div>
  </section>
</Base>
